+namespace {
+constexpr int replay_depth = 32768;
+constexpr int replay_steps = 256;
+constexpr int replay_layers = 6;
+constexpr int replay_groups = 2;
+constexpr int replay_topk = 16;
+constexpr int replay_per_step = replay_groups * replay_topk;
+
+struct gjallar_replay {
+    std::vector<uint8_t> route;
+    std::vector<int32_t> picks;
+
+    gjallar_replay() {
+        if (const char * file = std::getenv("GJALLAR_DIAGNOSTIC_ROUTE")) {
+            std::ifstream input(file, std::ios::binary);
+            route.assign(std::istreambuf_iterator<char>(input), {});
+            GGML_ASSERT(route.size() == replay_layers * replay_steps);
+            GGML_ASSERT(std::all_of(route.begin(), route.end(), [](uint8_t mode) { return mode <= 2; }));
+            if (std::find(route.begin(), route.end(), 2) != route.end()) {
+                const char * path = std::getenv("GJALLAR_DIAGNOSTIC_PICKS");
+                GGML_ASSERT(path != nullptr);
+                std::ifstream blocks(path, std::ios::binary);
+                picks.resize(replay_layers * replay_steps * replay_per_step);
+                GGML_ASSERT(blocks.read(reinterpret_cast<char *>(picks.data()), picks.size() * sizeof(int32_t)));
+                GGML_ASSERT(blocks.peek() == std::ifstream::traits_type::eof());
+            }
+            const auto & cfg = llama_bifrost_ret_cfg();
+            GGML_ASSERT(cfg.k == replay_topk && cfg.block == 64 && cfg.window == 512 && cfg.sinks == 4);
+        }
+    }
+};
+
+const gjallar_replay & replay_config() {
+    static const gjallar_replay config;
+    return config;
+}
